# Public API URL used by the mobile app
EXPO_PUBLIC_API_URL=https://YOUR_COOLIFY_DOMAIN/api

# MSG91 OTP Widget (client-side). These are intentionally public app-build values.
# For local Expo development, copy this file to .env.local and fill them in.
EXPO_PUBLIC_MSG91_WIDGET_ID=
EXPO_PUBLIC_MSG91_TOKEN_AUTH=

# false = use the MSG91 Widget. Set true only for local mock development.
EXPO_PUBLIC_MOCK_API=false

# EAS builds do not read this ignored local file. Add the same three EXPO_PUBLIC_*
# values to the EAS project environment for the preview and production profiles.
